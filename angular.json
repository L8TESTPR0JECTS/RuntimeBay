{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false, "cache": { "enabled": false } },
  "projects": { "runtime-bay": {
    "projectType": "application", "root": "", "sourceRoot": "frontend/src",
    "architect": { "build": {
      "builder": "@angular/build:application",
      "options": {
        "outputPath": "dist/web", "index": "frontend/src/index.html", "browser": "frontend/src/main.ts",
        "tsConfig": "frontend/tsconfig.app.json", "styles": ["frontend/src/styles.css", "frontend/src/containers.css", "frontend/src/loading/loading.css", "node_modules/@xterm/xterm/css/xterm.css", "frontend/src/terminals.css", "frontend/src/workflow-containers.css", "frontend/src/databases.css", "frontend/src/hosts.css"],
        "assets": [{"glob":"**/*","input":"frontend/src/assets","output":"assets"}]
      },
      "configurations": {
        "production": { "outputHashing": "all", "extractLicenses": true, "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false }, "budgets": [{"type":"initial","maximumWarning":"600kB","maximumError":"1MB"}] },
        "development": { "optimization": false, "sourceMap": true }
      },
      "defaultConfiguration": "production"
    } }
  } }
}
